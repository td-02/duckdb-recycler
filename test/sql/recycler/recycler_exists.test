statement ok
SET disabled_optimizers = '';

# ---------------------------------------------------------------------------
# the plan: with the rewrite, no delim join is left; without it, the planner's delim join runs
# ---------------------------------------------------------------------------
statement ok
SET recycler_exists_rewrite = true;

query II
EXPLAIN SELECT g, count(*) AS c FROM t JOIN d ON t.g % 5 = d.id WHERE EXISTS (SELECT 1 FROM f WHERE f.tid = t.id AND f.k = 1) GROUP BY g ORDER BY g
----
physical_plan	<!REGEX>:.*DELIM.*

query II
EXPLAIN SELECT g, count(*) AS c FROM t JOIN d ON t.g % 5 = d.id WHERE EXISTS (SELECT 1 FROM f WHERE f.tid = t.id AND f.k = 1) GROUP BY g ORDER BY g
----
physical_plan	<REGEX>:.*SEMI.*

statement ok
SET recycler_exists_rewrite = false;

query II
EXPLAIN SELECT g, count(*) AS c FROM t JOIN d ON t.g % 5 = d.id WHERE EXISTS (SELECT 1 FROM f WHERE f.tid = t.id AND f.k = 1) GROUP BY g ORDER BY g
----
physical_plan	<REGEX>:.*DELIM_JOIN.*

statement ok
SET recycler_exists_rewrite = true;

# the counters: a rewritten shape, one the rule leaves alone
statement ok
CREATE TABLE counters AS SELECT name, value FROM recycler_stats() WHERE name LIKE 'exists_%';

query I
SELECT count(*) FROM t WHERE EXISTS (SELECT 1 FROM f WHERE f.tid = t.id AND f.k = 1)
----
600

query I
SELECT count(*) FROM t WHERE EXISTS (SELECT 1 FROM f WHERE f.tid > t.id + 2990 AND f.k = 0)
----
5

query TI
SELECT s.name, s.value - c.value FROM recycler_stats() s JOIN counters c USING (name) WHERE s.name IN ('exists_rewrites', 'exists_refused') ORDER BY s.name
----
exists_refused	1
exists_rewrites	1

# a select list that would fail on rows no outer key matches: the rewrite replaces it by NULLs (a MARK join outputs
# none of its right side), so the query is rewritten and answers, also with the passes that would drop it disabled
statement ok
SET disabled_optimizers = 'filter_pushdown,unused_columns';

statement ok
CREATE TABLE counters_select AS SELECT name, value FROM recycler_stats() WHERE name = 'exists_rewrites';

query I
SELECT count(*) FROM d WHERE EXISTS (SELECT CAST(e.v AS INT) FROM e WHERE e.tid = d.id)
----
5

query I
SELECT s.value - c.value FROM recycler_stats() s JOIN counters_select c USING (name)
----
1

statement ok
SET disabled_optimizers = '';

# ---------------------------------------------------------------------------
# with the cache on, a rewritten block is still stored and still serves a narrower query
# ---------------------------------------------------------------------------
statement ok
SET recycler_enabled = true;

statement ok
SET preserve_insertion_order = false;


SELECT g, count(*) AS c FROM t JOIN d ON t.g % 5 = d.id JOIN s ON s.id = t.g WHERE y IS NOT NULL AND EXISTS (SELECT 1 FROM f WHERE f.tid = t.id AND f.k = 1) GROUP BY g ORDER BY g

# ---------------------------------------------------------------------------
# a block marker planted inside the subquery (the outer WHERE is not cacheable, the subquery's FROM/ON block is):
# the subquery is left to the planner. Rewritten, the subquery's own conjunct would sit directly above the marker,
# and the join order optimizer, which passes operators it does not know through, would push it below the marker:
# the stored block would then miss rows its key promises, and the second query here would read it.
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE p2 AS SELECT range AS id, range % 3000 AS tid, range % 9 AS v FROM range(4000);

query I
SELECT count(*) FROM t WHERE random() < 2 AND EXISTS (SELECT 1 FROM f JOIN p2 ON p2.tid = f.tid JOIN d ON d.id = f.k AND (d.id > 2 OR p2.v > 2) AND p2.v = 1 WHERE f.tid = t.id AND f.k = 3)
----
89

query I
SELECT count(*) FROM t WHERE random() < 2 AND EXISTS (SELECT 1 FROM f JOIN p2 ON p2.tid = f.tid JOIN d ON d.id = f.k AND (d.id > 2 OR p2.v > 2) AND p2.v = 1 WHERE f.tid = t.id)
----
178

query I
SELECT count(*) FROM t WHERE random() < 2 AND NOT EXISTS (SELECT 1 FROM f JOIN p2 ON p2.tid = f.tid JOIN d ON d.id = f.k AND (d.id > 2 OR p2.v > 2) AND p2.v = 1 WHERE f.tid = t.id)
----
2822

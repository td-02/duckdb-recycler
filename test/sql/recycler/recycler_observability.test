# name: test/sql/recycler/recycler_observability.test
# description: measured costs from profiles, sink statistics, byte accounting, refusal reasons and the signature history
# group: [recycler]

require waddle

statement ok
SET threads = 4;

statement ok
SET recycler_min_input_rows = 1;

statement ok
CREATE TABLE t AS SELECT range AS id, range % 7 AS g, range % 13 AS h FROM range(20000);

# every query over recycler_stats() / recycler_entries() / recycler_history() is itself refused as a table
# function scan: this first one counts itself
query I
SELECT value FROM recycler_stats() WHERE name = 'refused_table_function'
----
1

statement ok
SELECT count(*) FROM range(100000)

query I
SELECT value FROM recycler_stats() WHERE name = 'refused_table_function'
----
3

# ---------------------------------------------------------------------------
# a payer under EXPLAIN ANALYZE stores its aggregate (subtree) and its result (whole_result); both carry the
# thread time of the subtree they wrapped, their own materialization time, the sink calls that built them and
# the bytes their rows occupy
# ---------------------------------------------------------------------------
statement ok
EXPLAIN ANALYZE SELECT g, count(*) AS c FROM t GROUP BY g ORDER BY g

query I
SELECT count(*) FROM recycler_entries()
----
2

query I
SELECT bool_and(measured_cost_ms > 0 AND materialize_ms > 0 AND hit_ms = 0 AND sink_calls >= 1 AND used_bytes > 0 AND used_bytes <= bytes AND stored_at > 0 AND last_used = stored_at)
FROM recycler_entries()
----
true

# the history carries the same measurements under the entries' signatures
query I
SELECT count(*) FROM recycler_entries() e JOIN recycler_history() h ON h.key = e.key
----
2

query I
SELECT bool_and(h.rows = e.rows AND h.bytes = e.bytes AND h.measured_cost_ms = e.measured_cost_ms AND h.materialize_ms = e.materialize_ms AND h.hit_ms = 0 AND h.last_seen >= e.stored_at)
FROM recycler_entries() e JOIN recycler_history() h ON h.key = e.key
----
true

# a hit under EXPLAIN ANALYZE records the scan's time on the entry it served
statement ok
EXPLAIN ANALYZE SELECT g, count(*) AS c FROM t GROUP BY g ORDER BY g

query II
SELECT kind, hit_ms > 0 FROM recycler_entries() WHERE hits > 0
----
whole_result	true

query II
SELECT kind, hit_ms = 0 FROM recycler_entries() WHERE hits = 0
----
subtree	true

# the hit is noted in the history as well
query II
SELECT h.hit_ms > 0, h.last_seen > e.stored_at FROM recycler_entries() e JOIN recycler_history() h ON h.key = e.key WHERE e.hits > 0
----
true	true

# ---------------------------------------------------------------------------
# without a profile the sink's wall time stands in for the subtree cost and the materialization time stays unset
# ---------------------------------------------------------------------------
statement ok
PRAGMA recycler_clear

query I
SELECT count(*) FROM recycler_history()
----
0

statement ok
SELECT g, count(*) AS c FROM t WHERE h > 1 GROUP BY g ORDER BY g

query I
SELECT count(*) FROM recycler_entries()
----
2

query I
SELECT bool_and(measured_cost_ms > 0 AND materialize_ms = 0 AND sink_calls >= 1 AND used_bytes > 0 AND used_bytes <= bytes)
FROM recycler_entries()
----
true

# ---------------------------------------------------------------------------
# byte accounting: used bytes next to allocated bytes, swap of the process
# ---------------------------------------------------------------------------
query I
SELECT s.value = e.total
FROM recycler_stats() s, (SELECT sum(used_bytes) AS total FROM recycler_entries()) e
WHERE s.name = 'bytes_used'
----
true

query I
SELECT u.value <= a.value FROM recycler_stats() u, recycler_stats() a WHERE u.name = 'bytes_used' AND a.name = 'bytes'
----
true

query I
SELECT value >= 0 FROM recycler_stats() WHERE name = 'swap_bytes'
----
true

# ---------------------------------------------------------------------------
# a too-big verdict is reconsidered when the caps change: the recorded size is compared with the current caps
# ---------------------------------------------------------------------------
statement ok
SET recycler_entry_cap_rows = 1000

statement ok
SELECT id FROM t WHERE h = 0 ORDER BY id

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('too_big', 'writes_planned') ORDER BY name
----
too_big	1
writes_planned	5

# the history keeps the size of the materialization the caps stopped
query II
SELECT rows > 1000, bytes > 0 FROM recycler_history() WHERE rows > 1000
----
true	true

# the repeat is not materialized again under the same caps
statement ok
SELECT id FROM t WHERE h = 0 ORDER BY id

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('too_big', 'writes_planned') ORDER BY name
----
too_big	1
writes_planned	5

statement ok
SET recycler_entry_cap_rows = 4000000

statement ok
SELECT id FROM t WHERE h = 0 ORDER BY id

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('too_big', 'writes_planned') ORDER BY name
----
too_big	1
writes_planned	6

query I
SELECT count(*) FROM recycler_entries() WHERE rows > 1000
----
1

# ---------------------------------------------------------------------------
# refusal reasons: counted once per query root
# ---------------------------------------------------------------------------
query I
SELECT value FROM recycler_stats() WHERE name = 'refused_volatile_function'
----
0

statement ok
SELECT g, count(*) + random() FROM t GROUP BY g

query I
SELECT value FROM recycler_stats() WHERE name = 'refused_volatile_function'
----
1

query I
SELECT value FROM recycler_stats() WHERE name = 'refused_limit_without_order'
----
0

statement ok
SELECT id FROM t LIMIT 3

query I
SELECT value FROM recycler_stats() WHERE name = 'refused_limit_without_order'
----
1

# ---------------------------------------------------------------------------
# the history is bounded: 5000 distinct subtree candidates leave the 4096 most recently seen signatures
# ---------------------------------------------------------------------------
statement ok
CREATE TABLE u AS SELECT range AS id FROM range(10)

# the aggregates are noted as seen but nothing is materialized: the table is far below the input threshold
# (the constant sits inside the aggregate's argument, where no rewrite moves it out of the subtree)
statement ok
SET recycler_whole_result = false

statement ok
SET recycler_min_input_rows = 1000000

loop i 0 5000

statement ok
SELECT max(id + ${i}) FROM u

endloop

query I
SELECT value FROM recycler_stats() WHERE name = 'history_entries'
----
4096

# a refused root has no signature and takes no slot
loop i 0 10

statement ok
SELECT ${i} + random()

endloop

query I
SELECT value FROM recycler_stats() WHERE name = 'history_entries'
----
4096

query I
SELECT value FROM recycler_stats() WHERE name = 'refused_volatile_function'
----
11

# ---------------------------------------------------------------------------
# two block entries of one shape in one profiled query: the first one serves a narrower range through a
# RECYCLER_SCAN, the second one is materialized; each receives the time of its own operator only
# ---------------------------------------------------------------------------
statement ok
PRAGMA recycler_clear

statement ok
SET recycler_min_input_rows = 1

statement ok
SET preserve_insertion_order = false

statement ok
CREATE TABLE d AS SELECT range AS id, 'role' || range AS role FROM range(7)

statement ok
CREATE TABLE k AS SELECT range AS id, 'kind' || range AS kind FROM range(7)

# the payer is not profiled: its block keeps materialize_ms = 0, which the scan below must not overwrite
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE h BETWEEN 2 AND 5 GROUP BY g ORDER BY g
----
0	880
1	880
2	880
3	879
4	879
5	879
6	879

query I
SELECT count(*) FROM recycler_entries() WHERE kind = 'block'
----
1

statement ok
EXPLAIN ANALYZE SELECT count(*) FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE h BETWEEN 3 AND 4 UNION ALL SELECT count(*) FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE h BETWEEN 8 AND 9

query I
SELECT value FROM recycler_stats() WHERE name = 'subsumption_hits'
----
1

query IIII
SELECT hits, hit_ms > 0, materialize_ms > 0, measured_cost_ms > 0 FROM recycler_entries() WHERE kind = 'block' ORDER BY stored_at
----
1	true	false	true
0	false	true	true

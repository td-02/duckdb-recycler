# name: test/sql/recycler/recycler_runtime_filters.test
# description: a subtree whose scan receives runtime filters from a join above it is never stored with the rows those filters pruned
# group: [recycler]

require waddle

# one thread makes the pruning deterministic: the build side of every join then completes before the pipelines of
# its probe side start (PhysicalJoin::BuildJoinPipelines), so the outer join's filters reach the scan before it runs
statement ok
SET threads = 1;

# g is far wider than 32 bits so that compressed materialization puts no projection the join filters cannot pass
# through between the outer join and the scan
statement ok
CREATE TABLE facts AS SELECT range AS id, (range % 1000) * 10000000000 AS g, range % 5000 AS m FROM range(1000000);

statement ok
CREATE TABLE dims AS SELECT range AS id, range % 3 AS kind FROM range(5000);

# the partners span the whole range of g, so the optimizer derives no static filter from their statistics; their w = 1
# rows hit 50 groups each, disjoint between the two, and only those reach the join at runtime
statement ok
CREATE TABLE p1 AS
SELECT range * 10000000000 AS g, 0 AS w FROM range(0, 1000, 9)
UNION ALL SELECT 9990000000000, 0
UNION ALL SELECT range * 40000000000, 1 FROM range(50);

statement ok
CREATE TABLE p2 AS
SELECT range * 10000000000 AS g, 0 AS w FROM range(0, 1000, 9)
UNION ALL SELECT 9990000000000, 0
UNION ALL SELECT 5020000000000 + range * 40000000000, 1 FROM range(50);

statement ok
SET recycler_enabled = false;

# the scan of facts below the aggregate carries the filters of the join inside the aggregate (on m) and of the join
# above it (on g, through the group)
query II
EXPLAIN (ANALYZE, FORMAT JSON)
SELECT count(*), sum(s.c)
FROM (SELECT f.g, count(DISTINCT f.m) AS c FROM facts f JOIN dims d ON f.m = d.id WHERE d.kind = 1 GROUP BY f.g) s
JOIN p1 ON p1.g = s.g WHERE p1.w = 1
----
analyzed_plan	<REGEX>:(?s).*"Dynamic Filters": \[\s*"optional: m>=1 AND optional: m<=4999",\s*"optional: g IN .* AND optional: g>=0 AND optional: g<=1960000000000"\s*\].*

query I
SELECT count(*) FROM (SELECT f.g, count(DISTINCT f.m) AS c FROM facts f JOIN dims d ON f.m = d.id WHERE d.kind = 1 GROUP BY f.g)
----
1000

query II nosort q_p1
SELECT count(*), sum(s.c)
FROM (SELECT f.g, count(DISTINCT f.m) AS c FROM facts f JOIN dims d ON f.m = d.id WHERE d.kind = 1 GROUP BY f.g) s
JOIN p1 ON p1.g = s.g WHERE p1.w = 1
----

query II nosort q_p2
SELECT count(*), sum(s.c)
FROM (SELECT f.g, count(DISTINCT f.m) AS c FROM facts f JOIN dims d ON f.m = d.id WHERE d.kind = 1 GROUP BY f.g) s
JOIN p2 ON p2.g = s.g WHERE p2.w = 1
----

statement ok
SET recycler_enabled = true;

query II nosort q_p1
SELECT count(*), sum(s.c)
FROM (SELECT f.g, count(DISTINCT f.m) AS c FROM facts f JOIN dims d ON f.m = d.id WHERE d.kind = 1 GROUP BY f.g) s
JOIN p1 ON p1.g = s.g WHERE p1.w = 1
----

# the aggregate below the join is refused (the join above it prunes its scan); the query's own aggregate is stored
query II
SELECT kind, rows FROM recycler_entries() ORDER BY rows
----
subtree	1

query II nosort q_p2
SELECT count(*), sum(s.c)
FROM (SELECT f.g, count(DISTINCT f.m) AS c FROM facts f JOIN dims d ON f.m = d.id WHERE d.kind = 1 GROUP BY f.g) s
JOIN p2 ON p2.g = s.g WHERE p2.w = 1
----

query II nosort q_p1
SELECT count(*), sum(s.c)
FROM (SELECT f.g, count(DISTINCT f.m) AS c FROM facts f JOIN dims d ON f.m = d.id WHERE d.kind = 1 GROUP BY f.g) s
JOIN p1 ON p1.g = s.g WHERE p1.w = 1
----

query II
SELECT kind, rows FROM recycler_entries() ORDER BY rows
----
subtree	1
subtree	1

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('subtree_hits', 'subtree_stores') ORDER BY name
----
subtree_hits	1
subtree_stores	2

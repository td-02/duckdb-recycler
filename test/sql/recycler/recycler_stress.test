# name: test/sql/recycler/recycler_stress.test
# description: eight connections mix every query shape with writes while the shared cache is stored, served and cleared
# group: [recycler]

require waddle

statement ok
SET threads = 4;

statement ok
SET recycler_min_input_rows = 1;

statement ok
CREATE TABLE t AS
SELECT range AS id, range % 7 AS g, 1990 + range % 30 AS y, range % 13 AS h,
       CASE WHEN range % 2 = 0 THEN 'm' ELSE 'f' END AS gender
FROM range(300000);

statement ok
CREATE TABLE d AS SELECT range AS id, 'role' || range AS role FROM range(12);

statement ok
CREATE TABLE k AS SELECT range AS id, 'kind' || range AS kind FROM range(7);

# every thread runs each shape twice inside one read transaction: first with the recycler enabled
# (which may store or serve), then with it disabled for this connection (recycler_enabled is
# session-scoped; disabled_optimizers is a global setting and toggling it from several connections at
# once races against every other connection's optimizer). Both runs are checked against the same rows.
# Predicates such as "h <> 20 + ${i}" are always true: they give every thread its own keys for the
# whole-result and nested-block shapes without changing the answer; the subtree and block shapes
# share their keys across threads. Every iteration also writes to a thread-private table, which
# clears the shared cache under the other threads' feet.
# (loop variables are not substituted into query labels, so the rows are spelled out)

concurrentloop i 0 8

statement ok
SET recycler_min_input_rows = 1;

statement ok
CREATE TABLE w${i} (id INTEGER, v INTEGER);

loop j 0 4

statement ok
INSERT INTO w${i} SELECT range, range * ${i} FROM range(100);

query I
SELECT count(*) = (${j} + 1) * 100 FROM w${i}
----
true

statement ok
BEGIN TRANSACTION;

# shape 1: whole result (ordered aggregate)
query II
SELECT g, count(*) AS c FROM t WHERE h <> 20 + ${i} GROUP BY g ORDER BY g DESC
----
6	42857
5	42857
4	42857
3	42857
2	42857
1	42857
0	42858

statement ok
SET recycler_enabled = false;

query II
SELECT g, count(*) AS c FROM t WHERE h <> 20 + ${i} GROUP BY g ORDER BY g DESC
----
6	42857
5	42857
4	42857
3	42857
2	42857
1	42857
0	42858

statement ok
RESET recycler_enabled;

# shape 2: join + aggregate, shared across threads
query TI
SELECT d.role, count(*) AS c FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' GROUP BY d.role ORDER BY d.role
----
role0	21429
role1	21429
role2	21428
role3	21429
role4	21428
role5	21429
role6	21428

statement ok
SET recycler_enabled = false;

query TI
SELECT d.role, count(*) AS c FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' GROUP BY d.role ORDER BY d.role
----
role0	21429
role1	21429
role2	21428
role3	21429
role4	21428
role5	21429
role6	21428

statement ok
RESET recycler_enabled;

# shape 3: the same join under a different aggregate and order
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' GROUP BY g ORDER BY g DESC
----
6	21428
5	21429
4	21428
3	21429
2	21428
1	21429
0	21429

statement ok
SET recycler_enabled = false;

query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' GROUP BY g ORDER BY g DESC
----
6	21428
5	21429
4	21428
3	21429
2	21428
1	21429
0	21429

statement ok
RESET recycler_enabled;

# shape 4: nested block over shape 1's inner query
query II
SELECT * FROM (SELECT g, count(*) AS c FROM t WHERE h <> 20 + ${i} GROUP BY g ORDER BY g) sub WHERE sub.g IN (0, 6) ORDER BY g
----
0	42858
6	42857

statement ok
SET recycler_enabled = false;

query II
SELECT * FROM (SELECT g, count(*) AS c FROM t WHERE h <> 20 + ${i} GROUP BY g ORDER BY g) sub WHERE sub.g IN (0, 6) ORDER BY g
----
0	42858
6	42857

statement ok
RESET recycler_enabled;

# shape 5: wide SPJ block (subsumption payer)
query ITII
SELECT g, gender, count(*) AS c, max(y) AS my FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y IS NOT NULL AND d.id < 3 GROUP BY g, gender ORDER BY g, gender
----
0	f	21429	2019
0	m	21429	2018
1	f	21429	2019
1	m	21428	2018
2	f	21428	2019
2	m	21429	2018

statement ok
SET recycler_enabled = false;

query ITII
SELECT g, gender, count(*) AS c, max(y) AS my FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y IS NOT NULL AND d.id < 3 GROUP BY g, gender ORDER BY g, gender
----
0	f	21429	2019
0	m	21429	2018
1	f	21429	2019
1	m	21428	2018
2	f	21428	2019
2	m	21429	2018

statement ok
RESET recycler_enabled;

# shape 6: narrower block, served by subsumption from shape 5 when that is cached
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y BETWEEN 2000 AND 2005 AND d.id < 3 GROUP BY g ORDER BY g
----
0	8572
1	8571
2	8571

statement ok
SET recycler_enabled = false;

query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y BETWEEN 2000 AND 2005 AND d.id < 3 GROUP BY g ORDER BY g
----
0	8572
1	8571
2	8571

statement ok
RESET recycler_enabled;

# shape 7: ordered LIMIT
query II
SELECT id, h FROM t WHERE g = 5 AND id <> -1 - ${i} ORDER BY h DESC, id LIMIT 5
----
12	12
103	12
194	12
285	12
376	12

statement ok
SET recycler_enabled = false;

query II
SELECT id, h FROM t WHERE g = 5 AND id <> -1 - ${i} ORDER BY h DESC, id LIMIT 5
----
12	12
103	12
194	12
285	12
376	12

statement ok
RESET recycler_enabled;

statement ok
COMMIT;

endloop

query I
SELECT sum(v) = 4 * ${i} * 4950 FROM w${i}
----
true

statement ok
DROP TABLE w${i};

endloop

# the shared cache was exercised: results were served and the writers cleared it; keys never collided
query I
SELECT value >= 1 FROM recycler_stats() WHERE name = 'whole_hits'
----
true

query I
SELECT value >= 1 FROM recycler_stats() WHERE name = 'subtree_hits'
----
true

query I
SELECT value >= 8 FROM recycler_stats() WHERE name = 'clears'
----
true

query I
SELECT value FROM recycler_stats() WHERE name = 'hash_collisions'
----
0

# after the dust settles every shape is still answered correctly
query II
SELECT g, count(*) AS c FROM t GROUP BY g ORDER BY g DESC
----
6	42857
5	42857
4	42857
3	42857
2	42857
1	42857
0	42858

query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y BETWEEN 2000 AND 2005 AND d.id < 3 GROUP BY g ORDER BY g
----
0	8572
1	8571
2	8571

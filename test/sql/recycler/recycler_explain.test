# name: test/sql/recycler/recycler_explain.test
# description: EXPLAIN ANALYZE shows recycler hits in its profile; plain EXPLAIN neither stores nor serves
# group: [recycler]

require waddle

statement ok
SET threads = 4;

statement ok
SET recycler_min_input_rows = 1;

statement ok
CREATE TABLE t AS SELECT range AS id, range % 7 AS g, range % 13 AS h FROM range(20000);

statement ok
CREATE TABLE d AS SELECT range AS id, 'role' || range AS role FROM range(7);

# ---------------------------------------------------------------------------
# plain EXPLAIN of a never-seen query: no store, no hit, nothing in the cache
# ---------------------------------------------------------------------------
query II
EXPLAIN SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
physical_plan	<!REGEX>:.*RECYCLER.*

query I
SELECT count(*) FROM recycler_entries()
----
0

query I
SELECT value FROM recycler_stats() WHERE name = 'writes_planned'
----
0

# ---------------------------------------------------------------------------
# whole-result hit: the profile is a complete JSON document with a single RECYCLER_SCAN
# ---------------------------------------------------------------------------
# Within one profile node the order of operator_name and extra_info follows the standard library's hash map
# (libc++ and libstdc++ differ), so the patterns accept both; a node's children always follow its own fields.
query II
SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
0	2858
1	2857
2	2857
3	2857
4	2857
5	2857
6	2857

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
analyzed_plan	<REGEX>:(?s).*"latency": [0-9].*(?:"operator_name": "RECYCLER_SCAN".*"Kind": "whole_result".*"Rows": "7".*"Ordered": "true"|"Kind": "whole_result".*"Rows": "7".*"Ordered": "true".*"operator_name": "RECYCLER_SCAN").*

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
analyzed_plan	<!REGEX>:(?s).*"operator_name": "(HASH_GROUP_BY|PERFECT_HASH_GROUP_BY|SEQ_SCAN|ORDER_BY)".*

query I
SELECT value FROM recycler_stats() WHERE name = 'whole_hits'
----
2

# ---------------------------------------------------------------------------
# subtree hit: the same join and aggregate under a different ORDER BY is served below a sort
# ---------------------------------------------------------------------------
query TI
SELECT d.role, count(*) FROM t JOIN d ON t.g = d.id GROUP BY d.role ORDER BY d.role
----
role0	2858
role1	2857
role2	2857
role3	2857
role4	2857
role5	2857
role6	2857

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT d.role, count(*) FROM t JOIN d ON t.g = d.id GROUP BY d.role ORDER BY d.role DESC
----
analyzed_plan	<REGEX>:(?s).*"latency": [0-9].*"operator_name": "ORDER_BY".*(?:"operator_name": "RECYCLER_SCAN".*"Kind": "subtree".*"Rows": "7"|"Kind": "subtree".*"Rows": "7".*"operator_name": "RECYCLER_SCAN").*

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT d.role, count(*) FROM t JOIN d ON t.g = d.id GROUP BY d.role ORDER BY d.role DESC
----
analyzed_plan	<!REGEX>:(?s).*"operator_name": "(HASH_JOIN|SEQ_SCAN)".*

query I
SELECT value FROM recycler_stats() WHERE name = 'subtree_hits'
----
1

# the first EXPLAIN ANALYZE was admitted like any query: the second one is a whole-result hit
query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT d.role, count(*) FROM t JOIN d ON t.g = d.id GROUP BY d.role ORDER BY d.role DESC
----
analyzed_plan	<!REGEX>:(?s).*"operator_name": "(ORDER_BY|HASH_JOIN|SEQ_SCAN)".*

query I
SELECT value FROM recycler_stats() WHERE name = 'whole_hits'
----
4

# ---------------------------------------------------------------------------
# plain EXPLAIN of a cached query shows the vanilla plan and leaves the counters alone
# ---------------------------------------------------------------------------
query II
EXPLAIN SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
physical_plan	<!REGEX>:.*RECYCLER.*

query II
EXPLAIN SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
physical_plan	<REGEX>:.*GROUP_BY.*

query I
SELECT value FROM recycler_stats() WHERE name = 'whole_hits'
----
4

query I
SELECT value FROM recycler_stats() WHERE name = 'subtree_hits'
----
1

query I
SELECT value FROM recycler_stats() WHERE name = 'skip_not_query'
----
3

query I
SELECT count(*) FROM recycler_entries()
----
5

# ---------------------------------------------------------------------------
# the text format of a hit: the renderer titles an extension operator's box with its type, EXTENSION, so the
# served scan is recognised by its parameters, and no vanilla operator appears because the whole plan was replaced.
# Hits move no miss counter: the lookups counted so far all belong to statements above that were not served.
# ---------------------------------------------------------------------------
query I
SELECT value FROM recycler_stats() WHERE name = 'misses'
----
14

query II
EXPLAIN ANALYZE SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
analyzed_plan	<REGEX>:(?s).*EXTENSION.*Kind: whole_result.*Rows: 7.*Ordered: true.*

query II
EXPLAIN ANALYZE SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
analyzed_plan	<!REGEX>:(?s).*(HASH_GROUP_BY|PERFECT_HASH_GROUP_BY|SEQ_SCAN|ORDER_BY).*

# the grader reads the root latency, which precedes the first array of the document (the root's children)
query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
analyzed_plan	<REGEX>:(?s)^[^\[]*"latency": [0-9].*

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('misses', 'whole_hits') ORDER BY name
----
misses	14
whole_hits	7

# ---------------------------------------------------------------------------
# the same plan with different constants stored under EXPLAIN ANALYZE: each constant gets its own entry, neither
# is served the other's, and the plain queries get their own rows (WHERE h = 1 must never answer WHERE h = 2)
# ---------------------------------------------------------------------------
query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT g, count(*) FROM t WHERE h = 1 GROUP BY g ORDER BY g
----
analyzed_plan	<REGEX>:(?s).*"operator_name": "RECYCLER_MATERIALIZE".*

query II
EXPLAIN (ANALYZE, FORMAT JSON) SELECT g, count(*) FROM t WHERE h = 2 GROUP BY g ORDER BY g
----
analyzed_plan	<REGEX>:(?s).*"operator_name": "RECYCLER_MATERIALIZE".*

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('block_hits', 'subsumption_hits', 'subtree_hits', 'whole_hits') ORDER BY name
----
block_hits	0
subsumption_hits	0
subtree_hits	1
whole_hits	7

query II
SELECT g, count(*) FROM t WHERE h = 1 GROUP BY g ORDER BY g
----
0	220
1	220
2	219
3	220
4	220
5	220
6	220

query II
SELECT g, count(*) FROM t WHERE h = 2 GROUP BY g ORDER BY g
----
0	220
1	220
2	220
3	219
4	220
5	220
6	220

query I
SELECT value FROM recycler_stats() WHERE name = 'whole_hits'
----
9

# ---------------------------------------------------------------------------
# a write wrapped in EXPLAIN ANALYZE is a write: it is announced for t, its commit evicts every entry over t
# (all nine read t), nothing is cleared, and the next plain run is answered with the new row and stored again
# ---------------------------------------------------------------------------
statement ok
EXPLAIN ANALYZE INSERT INTO t VALUES (20000, 0, 0)

query I
SELECT count(*) FROM recycler_entries()
----
0

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('clears', 'invalidated_entries') ORDER BY name
----
clears	0
invalidated_entries	9

query II
SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
0	2859
1	2857
2	2857
3	2857
4	2857
5	2857
6	2857

query II
SELECT g, count(*) FROM t GROUP BY g ORDER BY g
----
0	2859
1	2857
2	2857
3	2857
4	2857
5	2857
6	2857

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('entries', 'whole_hits') ORDER BY name
----
entries	2
whole_hits	10

# ---------------------------------------------------------------------------
# recycler_enabled = false plans and stores nothing: the cache content is frozen while it is off
# ---------------------------------------------------------------------------
query I
SELECT value FROM recycler_stats() WHERE name = 'writes_planned'
----
11

statement ok
SET recycler_enabled = false;

query II
SELECT g, count(*) FROM t WHERE h = 3 GROUP BY g ORDER BY g
----
0	220
1	220
2	220
3	220
4	219
5	220
6	220

statement ok
RESET recycler_enabled;

query II
SELECT name, value FROM recycler_stats() WHERE name IN ('entries', 'skip_disabled', 'writes_planned') ORDER BY name
----
entries	2
skip_disabled	1
writes_planned	11

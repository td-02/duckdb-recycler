# name: test/sql/recycler/recycler_subsumption.test
# description: cached SPJ blocks are reused for narrower range predicates and column subsets (M5)
# group: [recycler]

require waddle

statement ok
SET threads = 4;

statement ok
SET preserve_insertion_order = false;

statement ok
SET recycler_min_input_rows = 1000;

statement ok
CREATE TABLE t AS
SELECT range AS id, range % 7 AS g, 1990 + range % 30 AS y, range % 13 AS h,
       CASE WHEN range % 2 = 0 THEN 'm' ELSE 'f' END AS gender
FROM range(300000);

statement ok
CREATE TABLE d AS SELECT range AS id, 'role' || range AS role FROM range(12);

statement ok
CREATE TABLE k AS SELECT range AS id, 'kind' || range AS kind FROM range(7);

# wide payer over all years, carrying g/gender/h/y
query ITIII
SELECT g, gender, count(*) AS c, count(DISTINCT h) AS nh, max(y) AS my FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y IS NOT NULL AND d.id < 3 GROUP BY g, gender ORDER BY g, gender
----
0	f	21429	13	2019
0	m	21429	13	2018
1	f	21429	13	2019
1	m	21428	13	2018
2	f	21428	13	2019
2	m	21429	13	2018

query I
SELECT value >= 1 FROM recycler_stats() WHERE name = 'blocks_planted'
----
true

query I
SELECT value >= 1 FROM recycler_stats() WHERE name = 'block_stores'
----
true

# narrower years, subset of columns: served from the block
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y BETWEEN 2000 AND 2005 AND d.id < 3 GROUP BY g ORDER BY g
----
0	8572
1	8571
2	8571

query I
SELECT value >= 1 FROM recycler_stats() WHERE name = 'subsumption_hits'
----
true

# single year, other columns
query TI
SELECT gender, count(DISTINCT h) AS n FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y = 2001 AND d.id < 3 GROUP BY gender ORDER BY gender
----
f	13

# open range
query TI
SELECT gender, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y > 2015 AND d.id < 3 GROUP BY gender ORDER BY gender
----
f	8571
m	8572

query I
SELECT value >= 3 FROM recycler_stats() WHERE name = 'subsumption_hits'
----
true

# column the block does not carry (k.kind): correct without a hit
query TI
SELECT k.kind, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y BETWEEN 2000 AND 2005 AND d.id < 3 GROUP BY k.kind ORDER BY k.kind
----
kind0	8572
kind1	8571
kind2	8571

# different non-range conjunct: a different shape
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y BETWEEN 2000 AND 2005 AND d.id < 2 GROUP BY g ORDER BY g
----
0	8572
1	8571

# narrow payer first (h in 3..5)
query III
SELECT g, h, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE h BETWEEN 3 AND 5 GROUP BY g, h ORDER BY g, h
----
0	3	3297
0	4	3297
0	5	3296
1	3	3297
1	4	3297
1	5	3297
2	3	3297
2	4	3297
2	5	3297
3	3	3297
3	4	3297
3	5	3297
4	3	3296
4	4	3297
4	5	3297
5	3	3296
5	4	3296
5	5	3297
6	3	3297
6	4	3296
6	5	3296

# wider than the narrow payer: must not be served from it
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE h BETWEEN 1 AND 9 GROUP BY g ORDER BY g
----
0	29671
1	29671
2	29670
3	29669
4	29670
5	29671
6	29671

# disjoint range: must not be served from it
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE h BETWEEN 6 AND 8 GROUP BY g ORDER BY g
----
0	9890
1	9889
2	9889
3	9890
4	9891
5	9891
6	9891

# exclusive vs inclusive bounds
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE h > 2 AND h < 6 GROUP BY g ORDER BY g
----
0	9890
1	9891
2	9891
3	9891
4	9890
5	9889
6	9889

# subset of the narrow payer
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE h = 4 GROUP BY g ORDER BY g
----
0	3297
1	3297
2	3297
3	3297
4	3297
5	3296
6	3296

statement ok
SET recycler_subsumption = false;

# subsumption disabled
query II
SELECT g, count(*) AS c FROM t JOIN d ON t.g = d.id JOIN k ON k.id = t.g WHERE y BETWEEN 1995 AND 1996 AND d.id < 3 GROUP BY g ORDER BY g
----
0	2857
1	2857
2	2857

statement ok
SET recycler_subsumption = true;

# two block entries of one shape differ only in the columns they store: a subtree over a scan of either must not be
# keyed by the shape hash alone, or the second query is served the first one's rows
statement ok
CREATE TABLE u AS SELECT range AS id, range % 7 AS g, 1990 + range % 30 AS y, range % 5 AS a, range % 11 AS b FROM range(300000)

# stores a block carrying [g, a]
query II
SELECT g, sum(a) FROM u JOIN d ON u.g = d.id JOIN k ON k.id = u.g WHERE y IS NOT NULL AND d.id < 3 GROUP BY g ORDER BY g
----
0	85716
1	85714
2	85716

# block hit: the aggregate above the scan is stored as a subtree
query II
SELECT g, sum(a) FROM u JOIN d ON u.g = d.id JOIN k ON k.id = u.g WHERE y IS NOT NULL AND d.id < 3 GROUP BY g ORDER BY g DESC
----
2	85716
1	85714
0	85716

# same shape, other columns: stores a second block carrying [g, b]
query II
SELECT g, sum(b) FROM u JOIN d ON u.g = d.id JOIN k ON k.id = u.g WHERE y IS NOT NULL AND d.id < 3 GROUP BY g ORDER BY g
----
0	214287
1	214281
2	214282

# block hit over the second entry: the aggregate renders like the one above it, but must not match it
query II
SELECT g, sum(b) FROM u JOIN d ON u.g = d.id JOIN k ON k.id = u.g WHERE y IS NOT NULL AND d.id < 3 GROUP BY g ORDER BY g DESC
----
2	214282
1	214281
0	214287

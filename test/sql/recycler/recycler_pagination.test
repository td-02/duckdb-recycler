SELECT count(*) FROM recycler_entries() WHERE kind = 'pagination'
----
0

query I rowsort e1
SELECT s.n1 FROM (SELECT t.name AS n1, w.pad AS n2, row_number() OVER (ORDER BY t.h DESC, t.id) rn FROM t JOIN k ON k.id = t.g JOIN w ON w.id = t.id WHERE t.g < 5) s WHERE rn > 0 AND rn <= 6000 UNION ALL SELECT s.n1 FROM (SELECT t.name AS n1, w.pad AS n2, row_number() OVER (ORDER BY t.h DESC, t.id) rn FROM t JOIN k ON k.id = t.g JOIN w ON w.id = t.id WHERE t.g < 5) s WHERE rn > 6000 AND rn <= 12000
----

# ---------------------------------------------------------------------------
# 11. prefix coverage, growth and accounting. A page stores 4x the rows it needs (rounded up to whole chunks), later
#     pages inside that coverage hit, a page beyond it grows the prefix geometrically and replaces the old entry
#     (keeping its hit history), and the byte accounting stays exact.
# ---------------------------------------------------------------------------
statement ok
SET preserve_insertion_order = false;

statement ok
PRAGMA recycler_clear;

query I nosort x1
SELECT t.id FROM t JOIN k ON k.id = t.g JOIN w ON w.id = t.id WHERE t.g < 5 ORDER BY t.h DESC, t.id LIMIT 6000 OFFSET 0
----

# 4 * 6000 = 24000 rows, a whole number of 2048-row chunks: 24576
query II
SELECT rows, hits FROM recycler_entries() WHERE kind = 'pagination'
----
24576	0

query I nosort x2
SELECT t.id FROM t JOIN k ON k.id = t.g JOIN w ON w.id = t.id WHERE t.g < 5 ORDER BY t.h DESC, t.id LIMIT 6000 OFFSET 6000
----

query I nosort x3
SELECT t.id FROM t JOIN k ON k.id = t.g JOIN w ON w.id = t.id WHERE t.g < 5 ORDER BY t.h DESC, t.id LIMIT 6000 OFFSET 12000
----

query II
SELECT rows, hits FROM recycler_entries() WHERE kind = 'pagination'
----
24576	2

# 36000 rows are needed but only 24576 are cached: miss, the prefix grows to max(4 * 36000, 2 * 24576) rows and
# replaces the old entry, which hands over its 2 hits
query I nosort x4
SELECT t.id FROM t JOIN k ON k.id = t.g JOIN w ON w.id = t.id WHERE t.g < 5 ORDER BY t.h DESC, t.id LIMIT 6000 OFFSET 30000
----

query III
SELECT count(*), bool_and(rows >= 144000 AND rows < 150000), max(hits) FROM recycler_entries() WHERE kind = 'pagination'
----
1	true	2

# a page inside the grown coverage hits
query I nosort x5

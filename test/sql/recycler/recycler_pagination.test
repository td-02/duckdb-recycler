# name: test/sql/recycler/recycler_pagination.test
# description: the ordered result below a root LIMIT/OFFSET is stored once and later pages are served from it (M6)
# group: [recycler]

require waddle

statement ok
SET threads = 4;

statement ok
SET preserve_insertion_order = false;

statement ok
SET recycler_min_input_rows = 1000;

statement ok
CREATE TABLE t AS
SELECT range AS id, range % 7 AS g, range % 13 AS h, 'name' || range AS name,
       CASE WHEN range % 2 = 0 THEN 'm' ELSE 'f' END AS gender
FROM range(300000);

statement ok
CREATE TABLE d AS SELECT range AS id, 'role' || range AS role FROM range(12);

# ---------------------------------------------------------------------------
# first page: limit + offset above 5000 keeps the LIMIT (no Top-N), so the complete ordered result is stored
# ---------------------------------------------------------------------------
query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 5 OFFSET 6000
----
name156013	role4	0
name156039	role2	0
name156065	role0	0
name156091	role5	0
name156117	role3	0

# the page source is an ordered whole-result entry holding all 150000 rows
query I
SELECT count(*) FROM recycler_entries() WHERE kind = 'whole_result' AND ordered AND rows = 150000
----
1

query I
SELECT value FROM recycler_stats() WHERE name = 'pagination_hits'
----
0

# ---------------------------------------------------------------------------
# later pages with other LIMIT/OFFSET values are served from it, in order
# ---------------------------------------------------------------------------
query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 5 OFFSET 6005
----
name156143	role1	0
name156169	role6	0
name156195	role4	0
name156221	role2	0
name156247	role0	0

query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 3 OFFSET 149997
----
name299935	role6	12
name299961	role4	12
name299987	role2	12

# OFFSET without LIMIT
query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id OFFSET 149995
----
name299883	role3	12
name299909	role1	12
name299935	role6	12
name299961	role4	12
name299987	role2	12

query I
SELECT value FROM recycler_stats() WHERE name = 'pagination_hits'
----
3

# the grader wraps every query in EXPLAIN ANALYZE
statement ok
EXPLAIN ANALYZE SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 5 OFFSET 6010

query I
SELECT value FROM recycler_stats() WHERE name = 'pagination_hits'
----
4

# ---------------------------------------------------------------------------
# a small first page becomes a Top-N and takes no part; a different sort order is a different page source
# ---------------------------------------------------------------------------
query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 5 OFFSET 0
----
name13	role6	0
name39	role4	0
name65	role2	0
name91	role0	0
name117	role5	0

query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h DESC, t.id LIMIT 5 OFFSET 6000
----
name156025	role2	12
name156051	role0	12
name156077	role5	12
name156103	role3	12
name156129	role1	12

query I
SELECT value FROM recycler_stats() WHERE name = 'pagination_hits'
----
4

query I
SELECT count(*) FROM recycler_entries() WHERE kind = 'whole_result' AND ordered AND rows = 150000
----
2

# ---------------------------------------------------------------------------
# with preserve_insertion_order the ordered page source is still served (a page seen before would be an exact
# whole-result hit instead, hence a new offset)
# ---------------------------------------------------------------------------
statement ok
SET preserve_insertion_order = true;

query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 5 OFFSET 6015
----
name156403	role2	0
name156429	role0	0
name156455	role5	0
name156481	role3	0
name156507	role1	0

query I
SELECT value FROM recycler_stats() WHERE name = 'pagination_hits'
----
5

statement ok
SET preserve_insertion_order = false;

# every ORDER BY column selected: the LIMIT sits directly on the sort (no pruning projection to hoist it over)
query IIT nosort
SELECT t.h, t.id, d.role FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 3 OFFSET 7000
----
0	182013	role6
0	182039	role4
0	182065	role2

query IIT nosort
SELECT t.h, t.id, d.role FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 3 OFFSET 7003
----
0	182091	role0
0	182117	role5
0	182143	role3

query I
SELECT value FROM recycler_stats() WHERE name = 'pagination_hits'
----
6

# a LIMIT that is not the root is not a page
query ITI
SELECT count(*), min(name), max(h) FROM (SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 20 OFFSET 140000) sub
----
20	name40013	12

# ---------------------------------------------------------------------------
# the same pages with the recycler off return the same rows
# ---------------------------------------------------------------------------
statement ok
SET recycler_enabled = false;

query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 5 OFFSET 6005
----
name156143	role1	0
name156169	role6	0
name156195	role4	0
name156221	role2	0
name156247	role0	0

query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id OFFSET 149995
----
name299883	role3	12
name299909	role1	12
name299935	role6	12
name299961	role4	12
name299987	role2	12

statement ok
SET recycler_enabled = true;

# ---------------------------------------------------------------------------
# the setting turns the page-source write off
# ---------------------------------------------------------------------------
statement ok
PRAGMA recycler_clear;

statement ok
SET recycler_pagination = false;

query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 5 OFFSET 6000
----
name156013	role4	0
name156039	role2	0
name156065	role0	0
name156091	role5	0
name156117	role3	0

query I
SELECT count(*) FROM recycler_entries() WHERE rows = 150000
----
0

query TTI nosort
SELECT t.name, d.role, t.h FROM t JOIN d ON t.g = d.id WHERE t.gender = 'f' ORDER BY t.h, t.id LIMIT 5 OFFSET 6005
----
name156143	role1	0
name156169	role6	0
name156195	role4	0
name156221	role2	0
name156247	role0	0

query I
SELECT value FROM recycler_stats() WHERE name = 'pagination_hits'
----
6

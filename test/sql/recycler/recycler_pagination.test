# ---------------------------------------------------------------------------
statement ok
PRAGMA recycler_clear;

query I rowsort e1
SELECT s.n1 FROM (SELECT t.name AS n1, w.pad AS n2, t.id FROM t JOIN k ON k.id = t.g JOIN w ON w.id = t.id WHERE t.g < 5 ORDER BY t.h DESC, t.id LIMIT 6000 OFFSET 0) s UNION ALL SELECT s.n1 FROM (SELECT t.name AS n1, w.pad AS n2, t.id FROM t JOIN k ON k.id = t.g JOIN w ON w.id = t.id WHERE t.g < 5 ORDER BY t.h DESC, t.id LIMIT 6000 OFFSET 6000) s

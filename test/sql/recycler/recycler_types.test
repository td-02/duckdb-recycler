# ---------------------------------------------------------------------------
# zero-row results: an empty filter result over a real table is stored and served; an empty table
# estimates zero input rows, which stays below the admission floor until that floor is zero
# ---------------------------------------------------------------------------
query II
SELECT id, s_uni FROM all_types WHERE id < 0 ORDER BY id
----

query II
SELECT id, s_uni FROM all_types WHERE id < 0 ORDER BY id
----

query I
SELECT value FROM recycler_stats() WHERE name = 'whole_hits'
----
4

query IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII
SELECT * FROM empty_t ORDER BY id
----

query IIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIIII
SELECT * FROM empty_t ORDER BY id
----

query I
SELECT value FROM recycler_stats() WHERE name = 'whole_hits'
----
